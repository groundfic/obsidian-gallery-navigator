{
  "name": "gallery-navigator",
  "version": "0.2.0",
  "description": "Visual vault navigator: folder/tag tree + cover card wall, with built-in image peek and link cards",
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:css && esbuild src/main.js --bundle --external:obsidian --external:@codemirror/* --format=cjs --outfile=main.js --target=es2020 --watch",
    "dev:css": "node scripts/build-css.mjs --watch",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run build:css && esbuild src/main.js --bundle --external:obsidian --external:@codemirror/* --format=cjs --outfile=main.js --target=es2020 --minify-whitespace"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
